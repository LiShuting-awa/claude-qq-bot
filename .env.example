# 复制为 .env 后填写
DRIVER=~aiohttp
HOST=127.0.0.1
PORT=8080
COMMAND_START=["/"]
LOG_LEVEL=INFO

ONEBOT_WS_URLS=["ws://127.0.0.1:3001"]
ONEBOT_ACCESS_TOKEN=qqbot-local-token

# 官方 Anthropic：填 ANTHROPIC_API_KEY（sk-ant-...），BASE_URL 留空
ANTHROPIC_API_KEY=
# 中转站：填 Bearer Token，并设置 BASE_URL；设置后优先于 API_KEY
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_AUTH_TOKEN_FILE=
# 中转站地址，例如 https://api.example.com；官方接口留空
ANTHROPIC_BASE_URL=
# 可选：额外请求头。JSON 对象、或 `名称: 值`（多条用逗号/换行分隔）都行
ANTHROPIC_CUSTOM_HEADERS={}
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=2048
# 人格文件，相对项目根目录；留空使用 CLAUDE_SYSTEM_PROMPT
CLAUDE_SYSTEM_PROMPT_FILE=

CLAUDE_GROUP_REQUIRE_AT=true
CLAUDE_GROUP_MEMORY_MODE=per_user
CLAUDE_ALLOWED_GROUPS=[]
CLAUDE_ALLOWED_USERS=[]
BLOCKED_USERS=[]

CLAUDE_HISTORY_MESSAGES=20
CLAUDE_HISTORY_MAX_CHARS=48000
CLAUDE_SESSION_TTL_MINUTES=180
CLAUDE_COOLDOWN_SECONDS=3
CLAUDE_CONCURRENCY=4
CLAUDE_TIMEOUT_SECONDS=180

CLAUDE_MAX_IMAGES=4
CLAUDE_IMAGE_MAX_MB=4

CLAUDE_CONVERT_MARKDOWN=true
CLAUDE_REPLY_CHUNK_CHARS=1200
CLAUDE_MAX_CHUNKS=4
# 超过 ack 延迟时先发的提示；留空=不发（「正在思考」很出戏，建议留空）
CLAUDE_ACK_TEXT=
CLAUDE_ACK_AFTER_SECONDS=8

# ===== 拟人节奏（阅读延迟 / 打字延迟 / 长回复分条） =====
CLAUDE_RHYTHM_ENABLED=true
CLAUDE_READ_DELAY_MAX_SECONDS=3.0
CLAUDE_TYPING_PER_CHAR_SECONDS=0.11
CLAUDE_TYPING_MAX_SECONDS=4.5
CLAUDE_BURST_ENABLED=true
CLAUDE_BURST_MIN_CHARS=60
CLAUDE_BURST_TARGET_CHARS=90
CLAUDE_BURST_MAX_EXTRA=2
CLAUDE_BURST_GAP_MIN_SECONDS=0.5
CLAUDE_BURST_GAP_MAX_SECONDS=1.6

# ===== 表情包（使用本号收藏） =====
STICKER_ENABLED=true
STICKER_COOLDOWN_SECONDS=60
STICKER_CATALOG_MAX=48

CLAUDE_DATA_DIR=data

# ===== 主动发言 =====
PROACTIVE_ENABLED=false
PROACTIVE_MODE=conversation
PROACTIVE_GROUPS=[]
PROACTIVE_CHECK_INTERVAL_SECONDS=60
PROACTIVE_WINDOW_MINUTES=10
PROACTIVE_MIN_MESSAGES=2
PROACTIVE_MAX_CONTEXT_MESSAGES=15
PROACTIVE_PROBABILITY=0.5
PROACTIVE_REPLY_DELAY_SECONDS=1
PROACTIVE_GENERATE_TIMEOUT_SECONDS=25
PROACTIVE_REPLY_PROBABILITY=1.0
PROACTIVE_MIN_REPLY_INTERVAL_SECONDS=10
PROACTIVE_INITIATIVE_AFTER_MINUTES=10
PROACTIVE_INITIATIVE_PROBABILITY=0.5
PROACTIVE_GROUP_COOLDOWN_MINUTES=1
PROACTIVE_DAILY_LIMIT_PER_GROUP=20
PROACTIVE_DAILY_LIMIT_TOTAL=60
PROACTIVE_QUIET_HOURS=23:00-08:00
PROACTIVE_MAX_CHARS=180
PROACTIVE_ALLOW_AT=true
PROACTIVE_PERSONA_FILE=persona.md
PROACTIVE_MODEL=

# 图片识别 / 解题（在已开启的群里生效）
PROACTIVE_IMAGE_ENABLED=true
PROACTIVE_IMAGE_DELAY_SECONDS=4
PROACTIVE_IMAGE_COOLDOWN_SECONDS=30
PROACTIVE_IMAGE_DAILY_LIMIT_PER_GROUP=20
PROACTIVE_IMAGE_MAX_MB=5
PROACTIVE_IMAGE_MAX_COUNT=4
PROACTIVE_IMAGE_MAX_CHARS=6000
PROACTIVE_IMAGE_CHUNK_CHARS=1200
PROACTIVE_IMAGE_MAX_TOKENS=1500
PROACTIVE_IMAGE_MODEL=

# ===== 图片生成（Pollinations，无需 Key） =====
IMAGE_GEN_ENABLED=true
IMAGE_GEN_API_URL=https://image.pollinations.ai/prompt
IMAGE_GEN_MODEL=flux
IMAGE_GEN_WIDTH=1024
IMAGE_GEN_HEIGHT=1024
IMAGE_GEN_TIMEOUT_SECONDS=120
IMAGE_GEN_COOLDOWN_SECONDS=30
IMAGE_GEN_DAILY_LIMIT_PER_USER=10
IMAGE_GEN_DAILY_LIMIT_TOTAL=50
IMAGE_GEN_MAX_PROMPT_CHARS=400
IMAGE_GEN_ALLOWED_GROUPS=[]
IMAGE_GEN_ALLOWED_USERS=[]

# ===== 链接视频下载（yt-dlp + ffmpeg） =====
MEDIA_DOWNLOAD_ENABLED=true
MEDIA_MAX_MB=80
MEDIA_MAX_DURATION_SECONDS=900
MEDIA_COOLDOWN_SECONDS=30
MEDIA_DAILY_LIMIT_PER_USER=10
MEDIA_SOCKET_TIMEOUT_SECONDS=30
MEDIA_ALLOWED_GROUPS=[]
MEDIA_ALLOWED_USERS=[]
# 可选：需要登录的站点用 Netscape 格式 cookies.txt
MEDIA_COOKIES_FILE=
# 可选：http://127.0.0.1:7890
MEDIA_PROXY=
MEDIA_AUTO_ENABLED=true
# 留空=所有群；只对已知视频站/直链 mp4 自动下载
MEDIA_AUTO_GROUPS=[]
MEDIA_AUTO_NOTIFY_ERRORS=true
MEDIA_AUTO_DEDUP_SECONDS=600

# ===== 网页链接阅读 + 感慨 =====
LINK_READER_ENABLED=true
# 留空=所有群；私聊也生效
LINK_READER_GROUPS=[]
LINK_READER_COOLDOWN_SECONDS=30
LINK_READER_DAILY_LIMIT_PER_USER=10
LINK_READER_TIMEOUT_SECONDS=20
LINK_READER_MAX_BYTES=2000000
LINK_READER_MAX_CHARS=6000
LINK_READER_NOTIFY_ERRORS=false

# ===== B 站信息卡 =====
BILIBILI_CARD_ENABLED=true
BILIBILI_NATIVE_AUTO=true
BILIBILI_MAX_HEIGHT=480
BILIBILI_JINA_BASE=https://r.jina.ai/

# ===== 链接解析 nonebot-plugin-parsehub（中国大陆平台优先）=====
PARSEHUB_AUTO=true
PARSEHUB_PLATFORMS=["douyin","kuaishou","weibo","xhs","tieba","zhihu","douban","toutiao","weixin","weixin_channels","coolapk","pipix","zuiyou","xiaoheihe","bangumi"]
PARSEHUB_MAX_FILE_MB=100
PARSEHUB_MAX_SECONDS=300
PARSEHUB_DEDUPE_SECONDS=120
PARSEHUB_CONCURRENCY=2
PARSEHUB_TIMEOUT=180
PARSEHUB_CACHE_TTL_HOURS=24
PARSEHUB_CACHE_MAX_MB=1024
PARSEHUB_CARD=true
PARSEHUB_SEND_TEXT=true
PARSEHUB_FAIL_NOTICE=true
PARSEHUB_DELIVERY=file
PARSEHUB_PROXY=
PARSEHUB_COOKIE=
BILI_SESSDATA=

# ===== 实时检索（无需 Key） =====
WEB_SEARCH_ENABLED=true
WEB_SEARCH_AUTO=true
WEB_SEARCH_MAX_RESULTS=6
WEB_SEARCH_TIMEOUT_SECONDS=15

# ===== 游戏社群 / 热榜 =====
COMMUNITY_ENABLED=true
COMMUNITY_HOT_LIMIT=8
COMMUNITY_TIMEOUT_SECONDS=20

# ===== 深度检索 / 本地知识库 =====
WEB_SEARCH_DEEP=true
WEB_SEARCH_DEEP_PAGES=2
KNOWLEDGE_ENABLED=true
KNOWLEDGE_DB_PATH=data/knowledge.db
KNOWLEDGE_MAX_RESULTS=3
# 正文短于这个长度、标题也没信息量的抓取结果不入库（搜索常带回空摘要）
KNOWLEDGE_MIN_CONTENT_CHARS=40
# 超过这么多天的旧资料在清理时删掉；0=不按时间清理
KNOWLEDGE_STALE_DAYS=120
# 排序里新鲜度的半衰期：越小越偏向最近抓到的资料
KNOWLEDGE_FRESHNESS_HALF_LIFE_DAYS=30

# ===== 长期记忆（跨会话记住群友是谁、在玩什么） =====
MEMORY_ENABLED=true
MEMORY_DB_PATH=data/memory.db
# 每次回答最多注入几条记忆
MEMORY_INJECT_LIMIT=6
# 每积累多少轮对话抽取一次（抽取本身也调用模型，别设太小）
MEMORY_EXTRACT_EVERY=3
MEMORY_MAX_FACTS_PER_SCOPE=200
# 自动抽取的记忆超过这么多天且从没被用到就清掉；0=不清理
MEMORY_PRUNE_STALE_DAYS=90

# ===== 模型自主工具调用 =====
CLAUDE_TOOLS_ENABLED=true
CLAUDE_MAX_TOOL_ROUNDS=3